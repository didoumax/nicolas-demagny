---
import Layout from "../../layouts/Layout.astro";
import { site, contact } from "../../data/content";
---

<Layout
  title="Contact & rendez-vous — Hypnose à Bordeaux, N. Demagny"
  description="Prendre rendez-vous avec Nicolas Demagny, hypnothérapeute à Bordeaux, 22 rue Turenne. Sur rendez-vous, du lundi au vendredi de 9h30 à 19h30."
>
  <section class="relative overflow-hidden bg-dark px-5 py-16 text-white md:px-10 md:py-24">
    <div class="reveal relative mx-auto max-w-[1280px]">
      <p class="eyebrow">Contact</p>
      <h1 class="mt-4 font-display text-4xl font-bold leading-[1.05] tracking-tight md:text-6xl">
        Prendre rendez-vous
      </h1>
      <p class="mt-6 max-w-lg text-on-dark-muted">{contact.note}</p>
    </div>
  </section>

  <section class="relative overflow-hidden bg-paper px-5 py-20 md:px-10 md:py-28">
    <div class="reveal relative mx-auto grid max-w-[1280px] gap-16 md:grid-cols-2">
      <div>
        <p class="eyebrow">Coordonnées</p>
        <p class="mt-6 font-display text-3xl font-bold text-ink">
          <a href={site.phoneHref} class="hover:underline">{site.phone}</a>
        </p>
        <p class="mt-4 text-ink-muted">{site.email}</p>
        <p class="mt-6 text-ink-muted">
          {site.address.street}<br />
          {site.address.postalCode} {site.address.city}
        </p>
        <p class="mt-4 text-ink-muted">{site.hours}</p>
        <ul class="mt-6 space-y-1 text-sm text-ink-muted">
          {site.access.map((line) => <li>{line}</li>)}
        </ul>
      </div>

      <form class="space-y-5 rounded-[24px] bg-white p-8" method="POST" action="#">
        <div class="absolute -left-[9999px]" aria-hidden="true">
          <label for="company">Société</label>
          <input type="text" id="company" name="company" tabindex="-1" autocomplete="off" />
        </div>
        <div>
          <label for="nom" class="text-sm font-semibold text-ink">Nom *</label>
          <input type="text" id="nom" name="nom" required class="mt-2 w-full rounded-xl border border-line-light bg-white px-4 py-3 text-ink focus:border-coral focus:outline-none" />
        </div>
        <div>
          <label for="telephone" class="text-sm font-semibold text-ink">Téléphone *</label>
          <input type="tel" id="telephone" name="telephone" required class="mt-2 w-full rounded-xl border border-line-light bg-white px-4 py-3 text-ink focus:border-coral focus:outline-none" />
        </div>
        <div>
          <label for="objet" class="text-sm font-semibold text-ink">Objet *</label>
          <input type="text" id="objet" name="objet" required class="mt-2 w-full rounded-xl border border-line-light bg-white px-4 py-3 text-ink focus:border-coral focus:outline-none" />
        </div>
        <div>
          <label for="message" class="text-sm font-semibold text-ink">Message *</label>
          <textarea id="message" name="message" rows="5" required class="mt-2 w-full rounded-xl border border-line-light bg-white px-4 py-3 text-ink focus:border-coral focus:outline-none"></textarea>
        </div>
        <button type="submit" class="btn-pill w-full justify-center">
          Envoyer
          <span class="btn-pill-icon" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
              <path d="M3 11L11 3M11 3H4.5M11 3V9.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </button>
      </form>
    </div>
  </section>
</Layout>

---
import Layout from "../../layouts/Layout.astro";
import RoundButton from "../../components/RoundButton.astro";
import { tarifs, site } from "../../data/content";
---

<Layout
  title="Tarifs des séances d'hypnose à Bordeaux — N. Demagny"
  description="Tarifs des séances d'hypnothérapie à Bordeaux : 100 € pour les sevrages (tabac, vapote, cannabis, CBD), 70 € pour les autres problématiques."
>
  <section class="relative overflow-hidden bg-dark px-5 py-16 text-white md:px-10 md:py-24">
    <div class="reveal relative mx-auto max-w-[1280px]">
      <p class="eyebrow">Tarifs</p>
      <h1 class="mt-4 font-display text-4xl font-bold leading-[1.05] tracking-tight md:text-6xl">
        Tarifs
      </h1>
    </div>
  </section>

  <section class="relative overflow-hidden bg-white px-5 py-20 md:px-10 md:py-28">
    <div class="reveal relative mx-auto max-w-[1280px]">
      <div class="grid gap-6 md:grid-cols-2">
        <div class="rounded-[24px] border border-line-light bg-paper p-10">
          <p class="eyebrow">Sevrages</p>
          <a href="/domaines-dintervention/sevrage-tabagique/" class="mt-4 block font-display text-xl font-bold text-ink hover:text-coral">{tarifs.sevrages.label}</a>
          <p class="mt-6 font-display text-5xl font-bold text-coral">{tarifs.sevrages.price}</p>
        </div>
        <div class="rounded-[24px] border border-line-light bg-paper p-10">
          <p class="eyebrow">Autres accompagnements</p>
          <p class="mt-4 font-display text-xl font-bold text-ink">{tarifs.autres.label}</p>
          <p class="mt-6 font-display text-5xl font-bold text-coral">{tarifs.autres.price}</p>
        </div>
      </div>

      <div class="mt-12 max-w-2xl space-y-2 text-ink-muted">
        {tarifs.note.split("\n").map((line) => <p>{line}</p>)}
      </div>

      <div class="mt-16 flex flex-wrap items-center gap-6">
        <RoundButton href="/contact/">Prendre rendez-vous</RoundButton>
        <a href={site.phoneHref} class="text-sm font-semibold text-ink">{site.phone}</a>
      </div>
    </div>
  </section>
</Layout>

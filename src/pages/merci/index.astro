---
import Layout from "../../layouts/Layout.astro";
import RoundButton from "../../components/RoundButton.astro";
import { site } from "../../data/content";
---

<Layout
  title="Message envoyé — Nicolas Demagny"
  description="Votre message a bien été envoyé à Nicolas Demagny."
>
  <section class="relative overflow-hidden bg-paper px-5 py-24 text-center md:px-10 md:py-32">
    <div class="reveal relative mx-auto max-w-xl">
      <p class="eyebrow">Message envoyé</p>
      <h1 class="mt-4 font-display text-3xl font-bold text-ink md:text-5xl">
        Merci, votre message a bien été envoyé.
      </h1>
      <p class="mt-6 text-ink-muted">
        Nicolas Demagny vous recontactera dans les meilleurs délais. Pour toute urgence, vous pouvez aussi l'appeler directement.
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <RoundButton href="/">Retour à l'accueil</RoundButton>
        <a href={site.phoneHref} class="text-sm font-semibold text-ink">{site.phone}</a>
      </div>
    </div>
  </section>
</Layout>

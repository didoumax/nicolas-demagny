---
import Layout from "../../layouts/Layout.astro";
import { site } from "../../data/content";
---

<Layout
  title="Mentions légales — Nicolas Demagny"
  description="Mentions légales du site de Nicolas Demagny, hypnothérapeute à Bordeaux."
>
  <section class="relative overflow-hidden bg-dark px-5 py-16 text-white md:px-10 md:py-24">
    <div class="reveal relative mx-auto max-w-[1280px]">
      <p class="eyebrow">Mentions légales</p>
      <h1 class="mt-4 font-display text-4xl font-bold leading-[1.05] tracking-tight md:text-6xl">
        Mentions légales
      </h1>
    </div>
  </section>

  <section class="relative overflow-hidden bg-white px-5 py-20 md:px-10 md:py-28">
    <div class="reveal relative mx-auto max-w-2xl space-y-6 text-ink-muted">
      <p>
        Le présent site est édité par <strong class="text-ink">{site.name}</strong>,
        domicilié {site.address.street}, {site.address.postalCode} {site.address.city}.
      </p>
      <p><strong class="text-ink">SIRET :</strong> {site.siret}</p>
      <p><strong class="text-ink">APE :</strong> {site.ape}</p>
      <p>
        <strong class="text-ink">Responsable de la publication :</strong> {site.legalRepresentative}
      </p>
      <p><strong class="text-ink">Contact :</strong> {site.phone} — {site.email}</p>
      <p><strong class="text-ink">Hébergeur :</strong> {site.hostNote}</p>
    </div>
  </section>
</Layout>

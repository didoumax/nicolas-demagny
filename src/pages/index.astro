---
import Layout from "../layouts/Layout.astro";
import RoundButton from "../components/RoundButton.astro";
import DomainesGrid from "../components/DomainesGrid.astro";
import HowItWorks from "../components/HowItWorks.astro";
import WhyChecklist from "../components/WhyChecklist.astro";
import Testimonials from "../components/Testimonials.astro";
import CtaFaq from "../components/CtaFaq.astro";
import PhotoPlaceholder from "../components/PhotoPlaceholder.astro";
import { site, domaines, domainesIntro, reperesConfiance } from "../data/content";

const domainesAccueil = domaines.filter((d) => d.showOnHome);
---

<Layout
  title="Hypnose ericksonienne et thérapies brèves à Bordeaux"
  description="Hypnothérapeute à Bordeaux : Nicolas Demagny accompagne par l'hypnose ericksonienne pour tabac, gestion des émotions, traumatismes et phobies, le plus souvent en 1 à 4 séances."
>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-paper px-5 pb-16 pt-14 md:px-10 md:pb-24 md:pt-20">
    <div class="mx-auto grid max-w-[1280px] items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div class="reveal text-center md:text-left">
        <p class="eyebrow">Hypnose ericksonienne — {site.city}</p>
        <h1 class="mt-6 font-display text-[clamp(38px,6vw,64px)] font-bold leading-[1.03] tracking-tight text-ink">
          Retrouvez le contrôle grâce à l'hypnose
        </h1>
        <p class="mx-auto mt-6 max-w-lg text-lg text-ink-muted md:mx-0">
          {domainesIntro}
        </p>
        <div class="mt-10 flex flex-wrap items-center justify-center gap-4 md:justify-start">
          <RoundButton href="/contact/">Prendre rendez-vous</RoundButton>
          <RoundButton href="/lhypnose-et-lhypnotherapie/" variant="outline" icon="play">Comprendre l'hypnose</RoundButton>
        </div>

        <div class="mx-auto mt-14 flex max-w-lg divide-x divide-line-light border-t border-line-light pt-8 text-center md:mx-0 md:text-left">
          {reperesConfiance.map((repere) => (
            <div class="flex-1 px-6 first:pl-0 last:pr-0">
              <p class="flex items-center justify-center gap-1 font-display text-3xl font-bold leading-none text-ink md:justify-start md:text-4xl">
                {repere.value}
                {repere.suffix ? <span class="text-coral">{repere.suffix}</span> : null}
              </p>
              <p class="mt-1.5 text-sm leading-snug text-ink-muted">{repere.label}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="reveal relative">
        <PhotoPlaceholder
          label="[PHOTO PORTRAIT HERO — à fournir par le client]"
          src="/images/nicolas-demagny-portrait.png"
          alt={`${site.name}, hypnothérapeute à ${site.city}`}
          rounded
          class="aspect-[4/5] w-full overflow-hidden shadow-[0_30px_60px_rgba(28,34,32,0.15)] lg:aspect-[5/6]"
        />
        <div class="absolute -bottom-6 -left-4 w-56 rounded-[18px] bg-white p-5 shadow-[0_20px_40px_rgba(28,34,32,0.15)] sm:left-6">
          <div class="flex items-center justify-between text-xs text-ink-muted">
            <span>Aujourd'hui, 16h30</span>
            <span class="flex items-center gap-1 font-semibold text-ink">
              <svg width="11" height="11" viewBox="0 0 12 12" fill="#F2785C" aria-hidden="true"><path d="M6 0.6L7.46 4.2L11.4 4.575L8.4 7.125L9.3 11.025L6 8.925L2.7 11.025L3.6 7.125L0.6 4.575L4.54 4.2L6 0.6Z"/></svg>
              4.9
            </span>
          </div>
          <p class="mt-2 font-display text-lg font-bold text-ink">{site.name}</p>
          <p class="text-sm text-ink-muted">Hypnothérapeute</p>
          <a href="/contact/" class="btn-pill mt-4 w-full justify-center !py-2 !pl-4 !text-sm">
            RDV
            <span class="btn-pill-icon !h-7 !w-7" aria-hidden="true">
              <svg width="12" height="12" viewBox="0 0 14 14" fill="none">
                <path d="M3 11L11 3M11 3H4.5M11 3V9.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- COMMENT SE DÉROULE UNE SÉANCE -->
  <section class="relative overflow-hidden bg-white px-5 pb-24 pt-14 md:px-10 md:pb-32 md:pt-16">
    <div class="reveal mx-auto max-w-[1280px]">
      <h2 class="mx-auto max-w-2xl text-center font-display text-3xl font-bold text-ink md:text-4xl">
        Comment se déroule un accompagnement.
      </h2>
      <div class="mt-16">
        <HowItWorks />
      </div>
    </div>
  </section>

  <!-- DOMAINES D'INTERVENTION -->
  <section id="domaines" class="relative overflow-hidden bg-dark px-5 py-24 text-on-dark md:px-10 md:py-32">
    <div class="mx-auto max-w-[1280px]">
      <div class="reveal text-center">
        <h2 class="mx-auto max-w-2xl font-display text-3xl font-bold md:text-4xl">
          Un accompagnement pour chaque besoin
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-on-dark-muted">{domainesIntro}</p>
      </div>

      <div class="mt-14">
        <DomainesGrid items={domainesAccueil} />
      </div>

      <div class="mt-14 text-center md:text-left">
        <RoundButton href="/contact/" variant="outline-on-dark">Prendre rendez-vous</RoundButton>
      </div>
    </div>
  </section>

  <!-- POURQUOI L'HYPNOSE ERICKSONIENNE -->
  <section class="relative overflow-hidden bg-white px-5 py-24 md:px-10 md:py-32">
    <div class="reveal mx-auto grid max-w-[1280px] gap-12 md:grid-cols-2 md:items-center md:gap-16">
      <div>
        <p class="eyebrow text-center md:text-left">Pourquoi l'hypnose ericksonienne</p>
        <h2 class="mt-4 text-center font-display text-3xl font-bold text-ink md:text-left md:text-5xl">
          Des changements. Avec fluidité.
        </h2>
        <WhyChecklist />
        <a href="/qui-suis-je/" class="underline-link mt-8 block text-center text-ink md:inline-block md:text-left">En savoir plus sur mon approche ↗</a>
      </div>
      <PhotoPlaceholder
        label="[VISUEL — CHANGEMENT]"
        src="/images/hypnose-changement.jpg"
        alt="Symbole du changement et de la transformation par l'hypnose"
        rounded
        class="aspect-square w-full shadow-[0_30px_60px_rgba(28,34,32,0.15)]"
      />
    </div>
  </section>

  <!-- TÉMOIGNAGES -->
  <Testimonials />

  <!-- CTA + FAQ -->
  <CtaFaq />
</Layout>

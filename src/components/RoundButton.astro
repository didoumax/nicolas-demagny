---
interface Props {
  href: string;
  variant?: "solid" | "outline" | "outline-on-dark";
  icon?: "arrow" | "play";
  class?: string;
}
const { href, variant = "solid", icon = "arrow", class: className = "" } = Astro.props;

const wrapperClass =
  variant === "solid"
    ? "btn-pill"
    : variant === "outline-on-dark"
      ? "btn-pill-outline btn-pill-outline--on-dark"
      : "btn-pill-outline";
---

<a href={href} class:list={[wrapperClass, className]}>
  <slot />
  <span class="btn-pill-icon" aria-hidden="true">
    {icon === "play" ? (
      <svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor">
        <path d="M2.5 1.5L10 6L2.5 10.5V1.5Z" />
      </svg>
    ) : (
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
        <path d="M3 11L11 3M11 3H4.5M11 3V9.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    )}
  </span>
</a>

---
interface Props {
  direction?: "left" | "right" | "up-right";
  variant?: "solid" | "outline" | "coral";
  label: string;
  class?: string;
  as?: "button" | "a";
  href?: string;
}
const {
  direction = "up-right",
  variant = "solid",
  label,
  class: className = "",
  as = "button",
  href,
} = Astro.props;

const paths: Record<string, string> = {
  left: "M9 3L3 9M3 9L9 15M3 9H15",
  right: "M9 3L15 9M15 9L9 15M15 9H3",
  "up-right": "M5 13L13 5M13 5H6.5M13 5V11.5",
};
const Tag = as === "a" ? "a" : "button";
---

<Tag
  href={as === "a" ? href : undefined}
  type={as === "button" ? "button" : undefined}
  class:list={[
    "btn-circle",
    variant === "outline" ? "btn-circle--outline" : "",
    variant === "coral" ? "!border-coral !bg-coral hover:!bg-coral-dark hover:!border-coral-dark" : "",
    className,
  ]}
  aria-label={label}
>
  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
    <path d={paths[direction]} stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
</Tag>

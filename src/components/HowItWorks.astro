---
import { commentSeance } from "../data/content";
---

<div class="grid gap-x-8 gap-y-12 md:grid-cols-3">
  {commentSeance.map((step, i) => (
    <div>
      <div class="flex items-center">
        <span class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full border-2 border-coral bg-white font-display text-xs font-bold text-coral">
          {step.n}
        </span>
        {i < commentSeance.length - 1 && (
          <span class="ml-3 hidden h-0.5 flex-1 bg-line-light md:block" aria-hidden="true"></span>
        )}
      </div>
      <h3 class="mt-6 font-display text-xl font-bold text-ink">{step.title}</h3>
      <p class="mt-2 text-ink-muted">{step.text}</p>
    </div>
  ))}
</div>

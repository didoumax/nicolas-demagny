---
interface Props {
  theme?: "light" | "dark";
  class?: string;
}
const { theme = "light", class: className = "" } = Astro.props;
const color = theme === "dark" ? "text-on-dark" : "text-ink";
---

<div class:list={["flex items-center gap-1", color, className]} role="img" aria-label="5 étoiles sur 5">
  {Array.from({ length: 5 }).map(() => (
    <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
      <path d="M8 0.8L9.95 5.6L15.2 6.1L11.2 9.5L12.4 14.7L8 11.9L3.6 14.7L4.8 9.5L0.8 6.1L6.05 5.6L8 0.8Z"/>
    </svg>
  ))}
</div>

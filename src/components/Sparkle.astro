---
// Puce ronde corail avec flèche — icône des cartes "domaines d'intervention"
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<span
  class:list={["icon-chip", className]}
  aria-hidden="true"
>
  <svg width="16" height="16" viewBox="0 0 18 18" fill="none">
    <path d="M5 13L13 5M13 5H6.5M13 5V11.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
</span>

---
import { domaines as allDomaines } from "../data/content";

interface Props {
  items?: typeof allDomaines[number][];
}
const { items = allDomaines } = Astro.props;
---

<div class="reveal scrollbar-hidden -mx-5 overflow-x-auto px-5 pb-2 md:-mx-10 md:px-10 [-webkit-overflow-scrolling:touch]">
  <div class="flex gap-5" style="width: max-content;">
    {items.map((domaine) => (
      <a
        href={`/domaines-dintervention/${domaine.slug}/`}
        class="card-dark group flex w-72 flex-shrink-0 flex-col p-7 transition-transform hover:-translate-y-1 md:w-80"
      >
        <div>
          <h3 class="font-display text-xl font-bold text-white">
            {domaine.title}
          </h3>
          {domaine.summary && (
            <p class="mt-3 text-sm leading-relaxed text-on-dark-muted">{domaine.summary}</p>
          )}
          {domaine.items.length > 0 && (
            <p class="mt-3 text-sm leading-relaxed text-on-dark-muted">{domaine.items.join(" · ")}</p>
          )}
        </div>
        <span class="btn-pill mt-8 w-fit self-start">
          En savoir plus
          <span class="btn-pill-icon" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
              <path d="M3 11L11 3M11 3H4.5M11 3V9.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </span>
      </a>
    ))}
  </div>
</div>

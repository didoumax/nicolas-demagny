---
import { deroule } from "../data/content";
---

<div class="divide-y divide-line-light border-y border-line-light">
  {deroule.map((step, i) => (
    <div class="js-accordion-item">
      <button
        type="button"
        class="js-accordion-trigger flex w-full items-center justify-between gap-6 py-6 text-left"
        aria-expanded={i === 0 ? "true" : "false"}
      >
        <span class="flex items-center gap-5">
          <span class="eyebrow text-paper-muted">{step.n}</span>
          <span class="font-display text-lg font-bold text-ink md:text-xl">{step.title}</span>
        </span>
        <span class="js-accordion-icon flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full border border-line-light text-ink transition-transform duration-300" aria-hidden="true">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
            <path d="M6 1V11M1 6H11" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
          </svg>
        </span>
      </button>
      <div class="js-accordion-panel grid overflow-hidden transition-all duration-300 ease-out" style={i === 0 ? "grid-template-rows: 1fr;" : "grid-template-rows: 0fr;"}>
        <div class="min-h-0">
          <p class="max-w-2xl pb-6 pl-[3.25rem] text-ink-muted">{step.text}</p>
        </div>
      </div>
    </div>
  ))}
</div>

<script>
  const items = document.querySelectorAll<HTMLElement>(".js-accordion-item");
  items.forEach((item) => {
    const trigger = item.querySelector<HTMLButtonElement>(".js-accordion-trigger");
    const panel = item.querySelector<HTMLElement>(".js-accordion-panel");
    const icon = item.querySelector<HTMLElement>(".js-accordion-icon");
    trigger?.addEventListener("click", () => {
      const isOpen = trigger.getAttribute("aria-expanded") === "true";
      items.forEach((other) => {
        if (other === item) return;
        other.querySelector(".js-accordion-trigger")?.setAttribute("aria-expanded", "false");
        const otherPanel = other.querySelector<HTMLElement>(".js-accordion-panel");
        if (otherPanel) otherPanel.style.gridTemplateRows = "0fr";
        other.querySelector<HTMLElement>(".js-accordion-icon")?.style.setProperty("transform", "rotate(0deg)");
      });
      trigger.setAttribute("aria-expanded", String(!isOpen));
      if (panel) panel.style.gridTemplateRows = isOpen ? "0fr" : "1fr";
      if (icon) icon.style.transform = isOpen ? "rotate(0deg)" : "rotate(45deg)";
    });
  });
</script>

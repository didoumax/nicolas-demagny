---
import { allReviews } from "../data/reviews";

// Séparer en 2 lignes alternées pour effet "nuage"
const row1 = allReviews.filter((_, i) => i % 2 === 0);
const row2 = allReviews.filter((_, i) => i % 2 !== 0);
---

<section class="relative overflow-hidden bg-white py-24 md:py-32" aria-labelledby="avis-wall-title">
  <div class="reveal mx-auto max-w-[1280px] px-5 md:px-10">
    <p class="eyebrow text-ink-muted">| Ils témoignent depuis 8 ans</p>
    <div class="mt-4 flex items-end justify-between">
      <h2 id="avis-wall-title" class="font-display text-3xl font-bold text-ink md:text-4xl">
        Ce que disent les personnes accompagnées
      </h2>
      <span class="eyebrow hidden text-ink-muted md:block">← Défiler →</span>
    </div>
  </div>

  <!-- Ligne 1 -->
  <div class="mt-10 overflow-x-auto pb-2 [-webkit-overflow-scrolling:touch]" aria-label="Avis clients (ligne 1)">
    <div class="flex gap-4 px-5 md:px-10" style="width: max-content;">
      {row1.map((review) => (
        <article class="w-72 flex-shrink-0 rounded-[18px] border border-line-light bg-paper p-6 md:w-80">
          <!-- Stars -->
          <div class="flex gap-0.5" aria-label={`${review.stars} étoiles sur 5`}>
            {Array.from({ length: review.stars }).map(() => (
              <svg width="12" height="12" viewBox="0 0 12 12" fill="#111111" aria-hidden="true">
                <path d="M6 0.6L7.46 4.2L11.4 4.575L8.4 7.125L9.3 11.025L6 8.925L2.7 11.025L3.6 7.125L0.6 4.575L4.54 4.2L6 0.6Z"/>
              </svg>
            ))}
          </div>
          <!-- Text -->
          <p class="mt-3 text-sm leading-relaxed text-ink">"{review.text}"</p>
          <!-- Author -->
          <div class="mt-4 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span
                class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full bg-black font-display text-xs font-bold text-white"
                aria-hidden="true"
              >
                {review.name.charAt(0).toUpperCase()}
              </span>
              <p class="text-xs font-semibold text-ink">{review.name}</p>
            </div>
            <span class="eyebrow text-[10px] text-paper-muted">{review.date}</span>
          </div>
          <p class="eyebrow mt-2 text-[10px] text-paper-muted">Avis vérifié — Source : Google</p>
        </article>
      ))}
    </div>
  </div>

  <!-- Ligne 2 (décalée visuellement) -->
  <div class="mt-4 overflow-x-auto pb-4 [-webkit-overflow-scrolling:touch]" aria-label="Avis clients (ligne 2)">
    <div class="flex gap-4 px-5 md:px-10" style="width: max-content; padding-left: calc(20px + 6rem);">
      {row2.map((review) => (
        <article class="w-72 flex-shrink-0 rounded-[18px] border border-line-light bg-paper p-6 md:w-80">
          <div class="flex gap-0.5" aria-label={`${review.stars} étoiles sur 5`}>
            {Array.from({ length: review.stars }).map(() => (
              <svg width="12" height="12" viewBox="0 0 12 12" fill="#111111" aria-hidden="true">
                <path d="M6 0.6L7.46 4.2L11.4 4.575L8.4 7.125L9.3 11.025L6 8.925L2.7 11.025L3.6 7.125L0.6 4.575L4.54 4.2L6 0.6Z"/>
              </svg>
            ))}
          </div>
          <p class="mt-3 text-sm leading-relaxed text-ink">"{review.text}"</p>
          <div class="mt-4 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span
                class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full bg-black font-display text-xs font-bold text-white"
                aria-hidden="true"
              >
                {review.name.charAt(0).toUpperCase()}
              </span>
              <p class="text-xs font-semibold text-ink">{review.name}</p>
            </div>
            <span class="eyebrow text-[10px] text-paper-muted">{review.date}</span>
          </div>
          <p class="eyebrow mt-2 text-[10px] text-paper-muted">Avis vérifié — Source : Google</p>
        </article>
      ))}
    </div>
  </div>
</section>

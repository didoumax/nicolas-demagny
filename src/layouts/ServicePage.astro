---
import Layout from "./Layout.astro";
import RoundButton from "../components/RoundButton.astro";
import PhotoPlaceholder from "../components/PhotoPlaceholder.astro";
import Testimonials from "../components/Testimonials.astro";
import FaqSchema from "../components/FaqSchema.astro";
import { site, bio } from "../data/content";
import type { ServicePageContent } from "../data/content";

interface Props {
  content: ServicePageContent;
}
const { content } = Astro.props;
---

<Layout title={content.metaTitle} description={content.metaDescription}>
  <FaqSchema faq={content.faq} slot="head" />

  <!-- 1. Hero -->
  <section class="relative overflow-hidden bg-paper px-5 pb-16 pt-14 md:px-10 md:pb-24 md:pt-20">
    <div class="reveal relative mx-auto grid max-w-[1280px] items-center gap-12 md:grid-cols-2">
      <div>
        <p class="eyebrow">{content.heroTitle}</p>
        <h1 class="mt-4 font-display text-[clamp(34px,5.5vw,56px)] font-bold leading-[1.05] tracking-tight text-ink">
          {content.heroTitle}
        </h1>
        <p class="mt-6 max-w-lg text-lg text-ink-muted">{content.heroSubtitle}</p>
        <div class="mt-10">
          <RoundButton href="/contact/">Prendre rendez-vous</RoundButton>
        </div>
      </div>
      <PhotoPlaceholder
        label="[VISUEL D'AMBIANCE — à fournir par le client]"
        src={content.heroImage}
        alt={content.heroTitle}
        rounded
        class="aspect-[4/3] w-full"
      />
    </div>
  </section>

  <!-- 2. Vous reconnaissez-vous ? -->
  <section class="relative overflow-hidden bg-white px-5 py-20 md:px-10 md:py-28">
    <div class="reveal relative mx-auto max-w-[1280px]">
      <p class="eyebrow">Vous reconnaissez-vous ?</p>
      <h2 class="mt-4 max-w-2xl font-display text-3xl font-bold text-ink md:text-4xl">
        Des situations qui vous parlent peut-être
      </h2>
      <ul class="mt-10 grid gap-6 md:grid-cols-2">
        {content.situations.map((situation) => (
          <li class="flex items-start gap-4 rounded-[18px] border border-line-light bg-paper p-5 text-ink-muted">
            <span class="icon-chip !h-8 !w-8 flex-shrink-0" aria-hidden="true">
              <svg width="12" height="12" viewBox="0 0 18 18" fill="none">
                <path d="M5 13L13 5M13 5H6.5M13 5V11.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <span>{situation}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3 & 4. Pourquoi / Comment -->
  <section class="relative overflow-hidden bg-dark px-5 py-20 text-on-dark md:px-10 md:py-28">
    <div class="reveal relative mx-auto grid max-w-[1280px] gap-12 md:grid-cols-2">
      <div>
        <p class="eyebrow">Pourquoi ça persiste</p>
        <p class="mt-6 text-lg leading-relaxed text-on-dark">{content.pourquoi}</p>
      </div>
      <div>
        <p class="eyebrow">Comment l'hypnose ericksonienne agit</p>
        <p class="mt-6 text-lg leading-relaxed text-on-dark">{content.comment}</p>
        <p class="card-dark mt-6 p-6 text-on-dark-muted">
          <span class="font-semibold text-white">Nombre de séances : </span>
          {content.seances}
        </p>
        <a href="/lhypnose-et-lhypnotherapie/" class="underline-link mt-4 inline-block text-on-dark">Comprendre l'hypnose ericksonienne ↗</a>
      </div>
    </div>
  </section>

  <!-- 5/6. Preuve -->
  <Testimonials />

  <!-- 7. Encart praticien -->
  <section class="relative overflow-hidden bg-paper px-5 py-20 md:px-10 md:py-28">
    <div class="reveal relative mx-auto flex max-w-3xl flex-col items-center gap-8 rounded-[28px] bg-white p-8 text-center shadow-[0_20px_50px_rgba(28,34,32,0.08)] sm:flex-row sm:items-center sm:gap-10 sm:p-10 sm:text-left">
      <PhotoPlaceholder
        label="[PORTRAIT NICOLAS DEMAGNY]"
        src="/images/nicolas-demagny-portrait.png"
        alt={site.name}
        rounded
        class="h-48 w-48 flex-shrink-0 sm:h-52 sm:w-52"
      />
      <div>
        <h2 class="font-display text-2xl font-bold text-ink md:text-3xl">Nicolas Demagny</h2>
        <p class="mt-3 text-ink-muted">{bio.paragraphs[1]}</p>
        <a href="/qui-suis-je/" class="underline-link mt-4 inline-block text-ink">En savoir plus sur mon approche ↗</a>
      </div>
    </div>
  </section>

  <!-- 8. FAQ -->
  <section class="relative overflow-hidden bg-white px-5 py-20 md:px-10 md:py-28">
    <div class="reveal relative mx-auto max-w-[1280px]">
      <p class="eyebrow">Questions fréquentes</p>
      <h2 class="mt-4 font-display text-3xl font-bold text-ink md:text-4xl">FAQ — {content.heroTitle}</h2>
      <div class="mt-10 divide-y divide-line-light border-y border-line-light">
        {content.faq.map((item) => (
          <details class="group py-6">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-display text-lg font-semibold text-ink">
              {item.question}
              <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full border border-line-light text-ink transition-transform duration-300 group-open:rotate-45" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                  <path d="M6 1V11M1 6H11" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                </svg>
              </span>
            </summary>
            <p class="mt-4 max-w-2xl text-ink-muted">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 9. CTA final -->
  <section class="relative overflow-hidden bg-paper px-5 py-24 text-center md:px-10 md:py-32">
    <div class="reveal relative mx-auto max-w-2xl">
      <h2 class="font-display text-3xl font-bold text-ink md:text-5xl">Envie d'avancer dès maintenant ?</h2>
      <p class="mt-4 text-ink-muted">Prenez rendez-vous pour un premier échange.</p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <RoundButton href="/contact/">Prendre rendez-vous</RoundButton>
        <a href={site.phoneHref} class="text-sm font-semibold text-ink">{site.phone}</a>
      </div>
    </div>
  </section>
</Layout>
